{
  "system_url": "https://localhost/systems/local/#room1",
  "template_url": "",
  "system": {},
  "template": {
    "info": {
      "processorType": "cp4",
      "lastModifiedDate": "2026-03-19",
      "systemType": "huddle",
      "comment": "Starter config - experiment room with mock devices"
    },
    "devices": [
      {
        "key": "mobileControl",
        "name": "Mobile Control",
        "type": "mobilecontrol",
        "group": "api",
        "properties": {
          "serverUrl": "http://localhost",
          "enableApiServer": true,
          "directServer": {
            "enableDirectServer": true,
            "port": 50002,
            "tokenKey": "local-dev-secret-1234"
          }
        }
      },
      {
        "key": "display-1",
        "name": "Samsung Display",
        "type": "samsungMdcPlugin",
        "group": "display",
        "properties": {
          "id": "00",
          "pollIntervalMs": 4500,
          "pollLedTemps": false,
          "warmingTimeMs": 1500,
          "coolingTimeMs": 1500,
          "showVolumeControls": true,
          "volumeUpperLimit": 100,
          "volumeLowerLimit": 0,
          "activeInputs": [
            { "key": "hdmi1", "name": "HDMI 1" },
            { "key": "hdmi2", "name": "HDMI 2" }
          ],
          "control": {
            "method": "tcpIp",
            "tcpSshProperties": {
              "address": "192.168.41.242",
              "port": 1515,
              "autoReconnect": true,
              "autoReconnectIntervalMs": 10000
            }
          }
        }
      },
      {
        "key": "source-1",
        "name": "HDMI 1",
        "type": "laptop",
        "group": "source",
        "properties": {}
      },
      {
        "key": "source-2",
        "name": "HDMI 2",
        "type": "genericSource",
        "group": "source",
        "properties": {}
      },
      {
        "key": "dsp-1",
        "name": "Q-SYS DSP",
        "type": "qscdsp",
        "group": "dsp",
        "properties": {
          "control": {
            "method": "tcpIp",
            "tcpSshProperties": {
              "address": "192.168.104.220",
              "port": 1702,
              "autoReconnect": true,
              "autoReconnectIntervalMs": 10000
            }
          },
          "levelControlBlocks": {
            "program": {
              "levelInstanceTag": "ProgramGain",
              "muteInstanceTag": "ProgramMute",
              "hasLevel": true,
              "hasMute": true,
              "disabled": false
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "key": "room1",
        "name": "Huddle Room",
        "type": "huddle",
        "properties": {
          "defaultDisplayKey": "display-1",
          "defaultAudioKey": "display-1",
          "sourceListKey": "default",
          "defaultSourceItem": "source-1",
          "hasDsp": false,
          "helpMessage": "",
          "defaultVideoBehavior": "basic",
          "volumes": {
            "master": {
              "level": 40,
              "deviceKey": "display-1",
              "label": "Volume"
            }
          },
          "logo": {
            "type": "system",
            "url": ""
          },
          "tech": {
            "password": "1234"
          }
        }
      }
    ],
    "sourceLists": {
      "default": {
        "roomOff": {
          "order": 0,
          "sourceKey": "$off",
          "type": "off",
          "includeInSourceList": false,
          "routeList": [
            {
              "sourceKey": "$off",
              "type": "audioVideo",
              "destinationKey": "$defaultAll"
            }
          ]
        },
        "source-1": {
          "order": 1,
          "name": "HDMI 1",
          "preferredName": "HDMI 1",
          "includeInSourceList": true,
          "sourceKey": "source-1",
          "type": "Route",
          "routeList": [
            {
              "sourceKey": "source-1",
              "type": "audioVideo",
              "destinationKey": "$defaultAll"
            }
          ]
        },
        "source-2": {
          "order": 2,
          "name": "HDMI 2",
          "preferredName": "HDMI 2",
          "includeInSourceList": true,
          "sourceKey": "source-2",
          "type": "Route",
          "routeList": [
            {
              "sourceKey": "source-2",
              "type": "audioVideo",
              "destinationKey": "$defaultAll"
            }
          ]
        }
      }
    },
    "tieLines": [
      {
        "sourceKey": "source-1",
        "sourcePort": "anyOut",
        "destinationKey": "display-1",
        "destinationPort": "hdmiIn1",
        "type": "audioVideo"
      },
      {
        "sourceKey": "source-2",
        "sourcePort": "anyOut",
        "destinationKey": "display-1",
        "destinationPort": "hdmiIn2",
        "type": "audioVideo"
      }
    ]
  }
}
